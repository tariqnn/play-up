# PlayUp uses generated Firebase platform configuration. Never place service-account
# JSON or private keys in this file.
FIREBASE_PROJECT_ID=your-uat-project-id
FIREBASE_WEB_API_KEY=your-web-api-key
GOOGLE_SERVER_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
UAT_TIMEZONE=Asia/Amman
UAT_CURRENCY=AED
