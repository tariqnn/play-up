rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && me().data.suspended != true; }
    function role(name) { return active() && me().data.role == name; }
    function superAdmin() { return role('superAdmin'); }
    function permission(name) {
      return superAdmin() || (active() && name in me().data.permissions);
    }
    function sameAcademy(academyId) {
      return (role('academyOwner') || role('academyStaff'))
        && me().data.academyId == academyId;
    }
    function ownsAcademy(academyId) {
      return role('academyOwner') && me().data.academyId == academyId;
    }
    function academyPermission(academyId, name) {
      return role('academyStaff')
        && me().data.academyId == academyId
        && name in me().data.permissions;
    }
    function assignedCourt(courtId, academyId) {
      return role('courtOwner')
        && me().data.academyId == academyId
        && courtId in me().data.courtIds;
    }
    function validSelfUpdate() {
      return request.resource.data.get('email', null) == request.auth.token.get('email', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'email', 'photoUrl', 'city', 'sports', 'skillLevels',
        'preferredTime', 'publicProfile', 'setupComplete', 'lastSeenAt',
        'fcmTokens', 'lastFcmTokenUpdatedAt', 'notificationPreferences',
        'privacyPreferences', 'mustChangePassword', 'passwordChangedAt',
        'updatedAt'
      ]);
    }
    function validManagedUserUpdate() {
      return resource.data.role != 'superAdmin'
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('permissions', []) == resource.data.get('permissions', [])
        && request.resource.data.get('academyId', null) == resource.data.get('academyId', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'suspended', 'updatedAt'
        ]);
    }
    function validPlayerCreate(userId) {
      return request.auth.uid == userId
        && request.resource.data.role == 'player'
        && request.resource.data.permissions == []
        && request.resource.data.suspended == false
        && request.resource.data.get('points', 0) == 0
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('level', 1) == 1
        && request.resource.data.get('nextLevelXp', 500) == 500
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('matches', 0) == 0
        && !('academyId' in request.resource.data);
    }
    function validAcademyOffer() {
      return request.resource.data.keys().hasOnly([
          'academyId', 'title', 'partner', 'points', 'pointsCost', 'category',
          'active', 'imageUrl', 'gradient', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.academyId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.pointsCost is int
        && request.resource.data.pointsCost > 0
        && request.resource.data.pointsCost <= 1000000
        && request.resource.data.active is bool;
    }
    function validPromotion() {
      return request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9_-]{3,32}$')
        && request.resource.data.discountType in ['percentage', 'fixed']
        && request.resource.data.discountValue is number
        && request.resource.data.discountValue >= 0
        && (request.resource.data.discountType != 'percentage'
          || request.resource.data.discountValue <= 100)
        && request.resource.data.get('usageCount', 0) is int
        && request.resource.data.get('usageCount', 0) >= 0
        && request.resource.data.get('usageLimit', 1) is int
        && request.resource.data.get('usageLimit', 1) > 0
        && request.resource.data.get('perUserLimit', 0) is int
        && request.resource.data.get('perUserLimit', 0) >= 0
        && request.resource.data.get('perUserLimit', 0) <= request.resource.data.get('usageLimit', 1)
        && request.resource.data.get('minimumSpendMinor', 0) is int
        && request.resource.data.get('minimumSpendMinor', 0) >= 0
        && request.resource.data.active is bool
        && (!('academyId' in request.resource.data)
          || request.resource.data.academyId == null
          || request.resource.data.academyId is string)
        && (!('courtId' in request.resource.data)
          || request.resource.data.courtId == null
          || request.resource.data.courtId is string)
        && (!('startsAt' in request.resource.data)
          || request.resource.data.startsAt == null
          || request.resource.data.startsAt is timestamp)
        && (!('endsAt' in request.resource.data)
          || request.resource.data.endsAt == null
          || request.resource.data.endsAt is timestamp);
    }
    function validAcademy() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && (!('status' in request.resource.data)
          || request.resource.data.status in ['active', 'suspended', 'onboarding'])
        && (!('currency' in request.resource.data)
          || request.resource.data.currency.matches('^[A-Z]{3}$'))
        && (!('platformCommissionPercent' in request.resource.data)
          || (request.resource.data.platformCommissionPercent is number
            && request.resource.data.platformCommissionPercent >= 0
            && request.resource.data.platformCommissionPercent <= 100))
        && (!('platformCommissionBps' in request.resource.data)
          || (request.resource.data.platformCommissionBps is int
            && request.resource.data.platformCommissionBps >= 0
            && request.resource.data.platformCommissionBps <= 10000));
    }
    function validCourt() {
      return request.resource.data.academyId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.sport is string
        && request.resource.data.sport.size() >= 2
        && request.resource.data.active is bool
        && request.resource.data.basePriceMinor is int
        && request.resource.data.basePriceMinor >= 0
        && request.resource.data.currency.matches('^[A-Z]{3}$')
        && request.resource.data.openingHour is int
        && request.resource.data.openingHour >= 0
        && request.resource.data.openingHour <= 23
        && request.resource.data.closingHour is int
        && request.resource.data.closingHour >= 1
        && request.resource.data.closingHour <= 24
        && request.resource.data.openingHour < request.resource.data.closingHour
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() >= 3;
    }

    match /users/{userId} {
      allow create: if signedIn() && (
        validPlayerCreate(userId) || superAdmin()
      );
      allow read: if signedIn() && (request.auth.uid == userId || permission('users.manage')
        || (role('academyOwner') && resource.data.academyId == me().data.academyId));
      allow update: if active() && (
        (request.auth.uid == userId && validSelfUpdate())
        || superAdmin()
        || (permission('users.manage') && validManagedUserUpdate())
      );
      allow delete: if superAdmin();

      match /pointsLedger/{entryId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /favorites/{courtId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /achievements/{achievementId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if active() && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;
    }

    match /academies/{academyId} {
      allow read: if true;
      allow create: if permission('academies.manage') && validAcademy();
      allow update: if (permission('academies.manage') && validAcademy()) ||
        ((ownsAcademy(academyId) || academyPermission(academyId, 'academy.profile.manage'))
          && validAcademy()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'address', 'latitude', 'longitude', 'phone', 'email',
          'imageUrl', 'description', 'sports', 'trainingPackages', 'packages', 'updatedAt'
        ]));
      allow delete: if superAdmin();
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create: if permission('communities.manage');
      allow update: if permission('communities.manage') ||
        (active() && role('communityOwner') && me().data.communityId == communityId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'sport', 'description', 'imageUrl', 'city', 'contactEmail',
            'contactPhone', 'websiteUrl', 'instagramUrl', 'updatedAt'
          ]));
      allow delete: if permission('communities.manage');
    }

    match /courts/{courtId} {
      allow read: if true;
      allow create: if validCourt() && (permission('academies.manage') ||
        (request.resource.data.academyId == me().data.academyId
          && (role('academyOwner') || permission('academy.courts.manage'))));
      allow update: if validCourt() && (permission('academies.manage') ||
        ((ownsAcademy(resource.data.academyId)
          || academyPermission(resource.data.academyId, 'academy.courts.manage')
          || assignedCourt(courtId, resource.data.academyId))
          && request.resource.data.academyId == resource.data.academyId));
      allow delete: if permission('academies.manage') ||
        ownsAcademy(resource.data.academyId) ||
        academyPermission(resource.data.academyId, 'academy.courts.manage') ||
        assignedCourt(courtId, resource.data.academyId);
    }

    match /offers/{id} {
      allow read: if true;
      allow create: if permission('platform.manage') ||
        (ownsAcademy(request.resource.data.academyId) && validAcademyOffer());
      allow update, delete: if permission('platform.manage') ||
        (ownsAcademy(resource.data.academyId)
          && request.resource.data.academyId == resource.data.academyId
          && validAcademyOffer());
    }

    match /events/{id} {
      allow read: if true;
      allow create: if permission('platform.manage') ||
        ownsAcademy(request.resource.data.academyId) ||
        (active() && role('communityOwner') && request.resource.data.communityId == me().data.communityId);
      allow update, delete: if permission('platform.manage') ||
        (ownsAcademy(resource.data.academyId)
          && request.resource.data.academyId == resource.data.academyId) ||
        (active() && role('communityOwner') && resource.data.communityId == me().data.communityId
          && request.resource.data.communityId == resource.data.communityId);
    }

    match /achievements/{id} {
      allow read: if active();
      allow create, update, delete: if permission('platform.manage');
    }

    match /tournaments/{tournamentId} {
      allow read: if active();
      allow create, update, delete: if false;

      match /registrations/{registrationId} {
        allow read: if active() && (request.auth.uid == registrationId
          || sameAcademy(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.academyId)
          || permission('platform.manage'));
        allow write: if false;
      }
    }

    match /bookings/{bookingId} {
      allow create: if false;
      allow read: if active() && (resource.data.userId == request.auth.uid
        || request.auth.uid in resource.data.get('participants', [])
        || permission('bookings.manage')
        || sameAcademy(resource.data.get('academyId', ''))
        || assignedCourt(resource.data.courtId, resource.data.academyId));
      allow update: if false;
      allow delete: if false;
    }

    match /bookingLocks/{slotKey} {
      // Availability is exposed only through the server-side quote/listing
      // callables so lock documents cannot leak user IDs or booking patterns.
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /matches/{matchId} {
      // Discovery exposes only joinable matches. Participants, assigned venue
      // operators, and platform match operators retain access to history.
      allow read: if signedIn() && resource.data.status in ['open', 'full'];
      allow read: if active() && (
        request.auth.uid in resource.data.players
        || permission('matchmaking.manage')
        || sameAcademy(resource.data.get('academyId', ''))
      );
      allow create, update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if active() && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.players;
        allow write: if false;
      }
    }

    match /userBlocks/{blockId} {
      // Blocks are created and removed only through authenticated server
      // callables so the participant pair and actor cannot be forged.
      allow read: if active() && request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;
    }

    match /bookingInvites/{inviteId} {
      allow read, create, update, delete: if false;
    }

    match /redemptions/{redemptionId} {
      allow read: if active() && (resource.data.userId == request.auth.uid
        || permission('platform.manage')
        || sameAcademy(resource.data.academyId)
        || assignedCourt(resource.data.courtId, resource.data.academyId));
      allow write: if false;
    }

    match /promotions/{promotionId} {
      allow read: if active();
      allow create: if validPromotion()
        && request.resource.data.get('usageCount', 0) == 0
        && permission('platform.manage');
      allow update: if validPromotion()
        && request.resource.data.code == resource.data.code
        && request.resource.data.get('usageCount', 0) == resource.data.get('usageCount', 0)
        && permission('platform.manage');
      allow delete: if permission('platform.manage');
    }

    match /notifications/{notificationId} {
      allow read: if active() && resource.data.userId == request.auth.uid;
      allow update: if active() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow create: if false;
      allow delete: if false;
    }

    match /dashboardLayouts/{userId} {
      allow read, create, update, delete: if active() && request.auth.uid == userId;
    }

    match /platformConfig/{configId} {
      allow read: if true;
      allow create, update: if permission('platform.manage');
      allow delete: if superAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'rating', 'tags', 'comment', 'createdAt'
        ])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 10
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow update: if permission('platform.manage')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hidden', 'moderationReason', 'moderatedBy', 'moderatedAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'category', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'open';
      allow read: if active() &&
        (resource.data.userId == request.auth.uid || permission('users.manage'));
      allow update: if permission('users.manage')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'operatorNotes', 'assignedTo', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if permission('audit.view');
      allow create: if false;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
