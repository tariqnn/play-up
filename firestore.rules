rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && me().data.suspended != true; }
    function role(name) { return active() && me().data.role == name; }
    function superAdmin() { return role('superAdmin'); }
    function permission(name) {
      return superAdmin() || (active() && name in me().data.permissions);
    }
    function sameAcademy(academyId) {
      return (role('academyOwner') || role('academyStaff'))
        && me().data.academyId == academyId;
    }
    function assignedCourt(courtId, academyId) {
      return role('courtOwner')
        && me().data.academyId == academyId
        && courtId in me().data.courtIds;
    }
    function immutableIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'permissions', 'academyId', 'courtIds', 'ownerType', 'suspended'
      ]);
    }
    function validPlayerCreate(userId) {
      return request.auth.uid == userId
        && request.resource.data.role == 'player'
        && request.resource.data.permissions == []
        && request.resource.data.suspended == false
        && request.resource.data.get('points', 0) == 0
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('level', 1) == 1
        && request.resource.data.get('nextLevelXp', 500) == 500
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('matches', 0) == 0
        && !('academyId' in request.resource.data);
    }

    match /users/{userId} {
      allow create: if signedIn() && (
        validPlayerCreate(userId) || permission('users.manage')
      );
      allow read: if signedIn() && (request.auth.uid == userId || permission('users.manage')
        || (role('academyOwner') && resource.data.academyId == me().data.academyId));
      allow update: if active() && (
        (request.auth.uid == userId && immutableIdentity()) || permission('users.manage')
      );
      allow delete: if superAdmin();

      match /pointsLedger/{entryId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /favorites/{courtId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /achievements/{achievementId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if active()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'displayName', 'photoUrl', 'city', 'level', 'xp',
          'sports', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if active() && request.auth.uid in resource.data.members;
      allow create: if active()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedTo in request.resource.data.members
        && request.resource.data.requestedTo != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if active()
        && resource.data.status == 'pending'
        && resource.data.requestedTo == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'respondedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if active() && request.auth.uid in resource.data.members;
    }

    match /academies/{academyId} {
      allow read: if true;
      allow create: if permission('academies.manage');
      allow update: if permission('academies.manage') ||
        (sameAcademy(academyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'address', 'latitude', 'longitude', 'phone', 'email',
          'imageUrl', 'description', 'sports', 'trainingPackages', 'updatedAt'
        ]));
      allow delete: if superAdmin();
    }

    match /courts/{courtId} {
      allow read: if true;
      allow create: if permission('academies.manage') ||
        ((role('academyOwner') || role('academyStaff'))
          && request.resource.data.academyId == me().data.academyId);
      allow update, delete: if permission('academies.manage') ||
        ((sameAcademy(resource.data.academyId)
          || assignedCourt(courtId, resource.data.academyId))
          && request.resource.data.academyId == resource.data.academyId);
    }

    match /offers/{id} {
      allow read: if true;
      allow create: if permission('platform.manage') ||
        (sameAcademy(request.resource.data.academyId));
      allow update, delete: if permission('platform.manage') ||
        (sameAcademy(resource.data.academyId)
          && request.resource.data.academyId == resource.data.academyId);
    }

    match /events/{id} {
      allow read: if true;
      allow create: if permission('platform.manage') ||
        (sameAcademy(request.resource.data.academyId));
      allow update, delete: if permission('platform.manage') ||
        (sameAcademy(resource.data.academyId)
          && request.resource.data.academyId == resource.data.academyId);
    }

    match /achievements/{id} {
      allow read: if active();
      allow create, update, delete: if permission('platform.manage');
    }

    match /tournaments/{tournamentId} {
      allow read: if active();
      allow create, update, delete: if false;

      match /registrations/{registrationId} {
        allow read: if active() && (request.auth.uid == registrationId
          || sameAcademy(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.academyId)
          || permission('platform.manage'));
        allow write: if false;
      }
    }

    match /bookings/{bookingId} {
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'cash'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.durationMinutes in [30, 60, 90, 120, 150, 180, 210, 240]
        && request.resource.data.lockIds.size() == request.resource.data.durationMinutes / 30
        && request.resource.data.startUtc > request.time
        && request.resource.data.endUtc > request.resource.data.startUtc
        && request.resource.data.courtId is string
        && get(/databases/$(database)/documents/courts/$(request.resource.data.courtId)).data.active == true;
      allow read: if active() && (resource.data.userId == request.auth.uid
        || permission('bookings.manage')
        || sameAcademy(resource.data.academyId)
        || assignedCourt(resource.data.courtId, resource.data.academyId));
      allow update: if active()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participants', 'updatedAt'
            ])
            && resource.data.status in ['pending', 'confirmed']
            && request.resource.data.participants.size() == resource.data.participants.size() + 1
            && request.resource.data.participants.hasAll(resource.data.participants)
            && request.auth.uid in request.resource.data.participants
            && !(request.auth.uid in resource.data.participants)
            && request.resource.data.participants.size() <= resource.data.playerCapacity
          ) || (
            (permission('bookings.manage')
              || sameAcademy(resource.data.academyId)
              || assignedCourt(resource.data.courtId, resource.data.academyId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'confirmedAt', 'checkedInAt', 'completedAt',
              'cancelledAt', 'updatedAt'
            ])
            && (
              (resource.data.status == 'pending' && request.resource.data.status in ['confirmed', 'cancelled'])
              || (resource.data.status == 'confirmed' && request.resource.data.status in ['checkedIn', 'cancelled'])
              || (resource.data.status == 'checkedIn' && request.resource.data.status == 'completed')
            )
          ) || (
            (permission('bookings.manage')
              || sameAcademy(resource.data.academyId)
              || assignedCourt(resource.data.courtId, resource.data.academyId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus', 'collectedAt', 'updatedAt'
            ])
            && request.resource.data.paymentStatus == 'collected'
          )
        );
      allow delete: if false;
    }

    match /bookingLocks/{slotKey} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.bookingId is string
        && request.resource.data.courtId is string
        && request.resource.data.startUtc > request.time
        && request.resource.data.endUtc > request.resource.data.startUtc
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
        && slotKey in getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.lockIds;
      allow update: if false;
      allow delete: if active()
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'cancelled'
        && (
          permission('bookings.manage')
          || sameAcademy(
            getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.academyId
          )
          || assignedCourt(
            resource.data.courtId,
            getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.academyId
          )
        );
    }

    match /matches/{matchId} {
      // Guests may browse the public match list. Messages remain restricted
      // to authenticated match participants below.
      allow read: if signedIn();
      allow create: if active()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.players == [request.auth.uid]
        && request.resource.data.playerNames.size() == 1
        && request.resource.data.status == 'open'
        && request.resource.data.capacity >= 2
        && request.resource.data.capacity <= 30
        && request.resource.data.neededPlayers == request.resource.data.capacity - 1
        && request.resource.data.startUtc > request.time
        && request.resource.data.type in ['Casual', 'Competitive']
        && request.resource.data.ranked == (request.resource.data.type == 'Competitive')
        && (
          (
            request.resource.data.source == 'external'
            && permission('matchmaking.manage')
            && request.resource.data.courtId == ''
            && request.resource.data.bookingId == null
            && request.resource.data.venueNote is string
            && request.resource.data.venueNote.size() >= 3
          ) || (
            request.resource.data.source == 'playupCourt'
            && request.resource.data.courtId is string
            && get(/databases/$(database)/documents/courts/$(request.resource.data.courtId)).data.active == true
          )
        );
      allow update: if active()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'playerNames', 'neededPlayers', 'updatedAt'
        ])
        && !(request.auth.uid in resource.data.players)
        && request.auth.uid in request.resource.data.players
        && request.resource.data.players.size() == resource.data.players.size() + 1
        && request.resource.data.players.hasAll(resource.data.players)
        && request.resource.data.playerNames.size() == resource.data.playerNames.size() + 1
        && request.resource.data.neededPlayers == resource.data.neededPlayers - 1
        && request.resource.data.players.size() <= resource.data.capacity;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if active() && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.players;
        allow write: if false;
      }
    }

    match /bookingInvites/{inviteId} {
      allow get: if active();
      allow list: if false;
      allow create: if active()
        && request.resource.data.token == inviteId
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid;
      allow update: if active()
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uses', 'updatedAt'
        ])
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.uses <= resource.data.maxUses;
      allow delete: if active() && resource.data.createdBy == request.auth.uid;
    }

    match /redemptions/{redemptionId} {
      allow read: if active() && (resource.data.userId == request.auth.uid
        || permission('platform.manage')
        || sameAcademy(resource.data.academyId)
        || assignedCourt(resource.data.courtId, resource.data.academyId));
      allow write: if false;
    }

    match /promotions/{promotionId} {
      allow read: if active();
      allow create: if permission('platform.manage') ||
        (sameAcademy(request.resource.data.academyId));
      allow update, delete: if permission('platform.manage') ||
        (sameAcademy(resource.data.academyId)
          && request.resource.data.academyId == resource.data.academyId);
    }

    match /notifications/{notificationId} {
      allow read: if active() && resource.data.userId == request.auth.uid;
      allow update: if active() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['bookingCreated', 'bookingReminder']
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly([
          'userId', 'type', 'title', 'body', 'bookingId', 'startUtc', 'read', 'createdAt'
        ]);
      allow delete: if false;
    }

    match /dashboardLayouts/{userId} {
      allow read, create, update, delete: if active() && request.auth.uid == userId;
    }

    match /platformConfig/{configId} {
      allow read: if permission('platform.manage');
      allow create, update: if permission('platform.manage');
      allow delete: if superAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if active();
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow update: if permission('platform.manage');
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow read, update: if active() &&
        (resource.data.userId == request.auth.uid || permission('users.manage'));
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if permission('audit.view');
      allow create: if active()
        && request.resource.data.actorId == request.auth.uid
        && !request.resource.data.keys().hasAny(['password','token','cardNumber','secret']);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
