rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && me().data.suspended != true; }
    function role(name) { return active() && me().data.role == name; }
    function superAdmin() { return role('superAdmin'); }
    function permission(name) {
      return superAdmin() || (active() && name in me().data.permissions);
    }
    function academyUser() {
      return role('academyOwner') || role('academyStaff');
    }
    function sameAcademy(academyId) {
      return academyUser() && me().data.academyId == academyId;
    }
    function immutableIdentity() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.academyId == resource.data.academyId
        && request.resource.data.suspended == resource.data.suspended;
    }
    function validPlayerCreate(userId) {
      return request.auth.uid == userId
        && request.resource.data.role == 'player'
        && request.resource.data.permissions == []
        && request.resource.data.suspended == false
        && !('academyId' in request.resource.data);
    }

    match /users/{userId} {
      allow create: if signedIn() && validPlayerCreate(userId);
      allow read: if active() && (request.auth.uid == userId || permission('users.manage'));
      allow update: if active() && (
        (request.auth.uid == userId && immutableIdentity()) || permission('users.manage')
      );
      allow delete: if superAdmin();
    }

    match /academies/{academyId} {
      allow read: if true;
      allow create: if permission('academies.manage');
      allow update: if permission('academies.manage') || sameAcademy(academyId);
      allow delete: if superAdmin();
    }

    match /courts/{courtId} {
      allow read: if true;
      allow create: if permission('academies.manage') ||
        (academyUser() && request.resource.data.academyId == me().data.academyId);
      allow update, delete: if permission('academies.manage') ||
        (academyUser() && resource.data.academyId == me().data.academyId
          && request.resource.data.academyId == resource.data.academyId);
    }

    match /offers/{id} {
      allow read: if true;
      allow create: if permission('platform.manage') ||
        (academyUser() && request.resource.data.academyId == me().data.academyId);
      allow update, delete: if permission('platform.manage') ||
        (academyUser() && resource.data.academyId == me().data.academyId
          && request.resource.data.academyId == resource.data.academyId);
    }

    match /events/{id} {
      allow read: if true;
      allow write: if permission('platform.manage');
    }

    match /bookings/{bookingId} {
      allow create: if false;
      allow read: if active() && (resource.data.userId == request.auth.uid
        || permission('bookings.manage')
        || (academyUser() && resource.data.academyId == me().data.academyId));
      allow update: if false;
      allow delete: if false;
    }

    match /bookingLocks/{slotKey} {
      allow read: if false;
      allow create: if false;
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if active();
      allow create, update: if false;
      allow delete: if false;
    }

    match /promotions/{promotionId} {
      allow read: if active();
      allow create: if permission('platform.manage') ||
        (academyUser() && request.resource.data.academyId == me().data.academyId);
      allow update, delete: if permission('platform.manage') ||
        (academyUser() && resource.data.academyId == me().data.academyId
          && request.resource.data.academyId == resource.data.academyId);
    }

    match /notifications/{notificationId} {
      allow read: if active() && resource.data.userId == request.auth.uid;
      allow update: if active() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow create, delete: if false;
    }

    match /dashboardLayouts/{userId} {
      allow read, create, update, delete: if active() && request.auth.uid == userId;
    }

    match /reviews/{reviewId} {
      allow read: if active();
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow update: if permission('platform.manage');
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow read, update: if active() &&
        (resource.data.userId == request.auth.uid || permission('users.manage'));
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if permission('audit.view');
      allow create: if active()
        && request.resource.data.actorId == request.auth.uid
        && !request.resource.data.keys().hasAny(['password','token','cardNumber','secret']);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
