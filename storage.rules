rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function canManageCourt(academyId, courtId) {
      return signedIn() && profile().suspended != true && (
        profile().role == 'superAdmin' ||
        'academies.manage' in profile().permissions ||
        (
          profile().academyId == academyId &&
          (
            profile().role == 'academyOwner' ||
            (profile().role == 'academyStaff' &&
              'academy.courts.manage' in profile().permissions)
          )
        ) ||
        (
          profile().academyId == academyId &&
          profile().role == 'courtOwner' &&
          courtId in profile().courtIds
        )
      );
    }

    match /court-images/{academyId}/{courtId}/{fileName} {
      allow read: if true;
      allow write: if canManageCourt(academyId, courtId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    match /profile-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    match /academy-images/{academyId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && profile().suspended != true && (
        profile().role == 'superAdmin' ||
        'academies.manage' in profile().permissions ||
        (profile().academyId == academyId && (
          profile().role == 'academyOwner' ||
          (profile().role == 'academyStaff' && 'academy.profile.manage' in profile().permissions)
        ))
      )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    match /community-images/{communityId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && profile().suspended != true && (
        profile().role == 'superAdmin' ||
        'communities.manage' in profile().permissions ||
        (profile().role == 'communityOwner' && profile().communityId == communityId)
      )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }
  }
}
